// EXPLO CONTROL — modelo de dados (Etapa 1)
//
// Princípios:
// - O saldo NUNCA é gravado diretamente: é a soma das movimentações VALIDADAS (livro-razão).
// - Cada empresa (CNPJ) é separada juridicamente; cada unidade (paiol) pertence a uma empresa.
// - Catálogo central (Produto) + vínculo operacional por unidade (ProdutoUnidade).
// - Transferência: a saída é debitada na origem ao enviar; a entrada só é creditada no destino
//   após conferência. Entre os dois momentos a quantidade é "estoque em trânsito".
//   Estoque do grupo = saldo disponível de todas as unidades + em trânsito (sem duplicar).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // conexão direta, usada só pelas migrações (em hospedagens com pool, ex.: Supabase)
}

enum Situacao {
  ATIVO
  INATIVO
}

enum Perfil {
  ADMIN // administra cadastros, usuários e aprova divergências
  GESTOR // aprova lançamentos e transferências das suas unidades
  OPERADOR // registra lançamentos nas suas unidades
  CONSULTA // somente leitura
}

enum ClassificacaoProduto {
  EXPLOSIVO
  ACESSORIO_EXPLOSIVO
  INSUMO_PRODUCAO
  MATERIAL_GERAL
}

enum TipoMovimento {
  ENTRADA // recebimento de fornecedor/documento
  CONSUMO // baixa administrativa por consumo
  TRANSFERENCIA_SAIDA // débito na origem ao enviar
  TRANSFERENCIA_ENTRADA // crédito no destino ao confirmar recebimento
  TRANSFERENCIA_RETORNO // crédito na origem quando divergência é resolvida como retorno
  TRANSFERENCIA_SOBRA // crédito no destino de sobra aprovada
  PRODUCAO_ENTRADA // produto acabado (ex.: emulsão) — Etapa de produção
  PRODUCAO_CONSUMO // insumos consumidos na produção — Etapa de produção
  AJUSTE_INVENTARIO // ajuste aprovado após inventário
}

enum StatusMovimento {
  PENDENTE // aguardando validação
  VALIDADO // compõe o saldo
  REJEITADO
  ESTORNADO
}

enum StatusTransferencia {
  RASCUNHO
  PENDENTE_ENVIO
  EM_TRANSITO
  AGUARDANDO_CONFERENCIA
  RECEBIDA
  DIVERGENTE
  CANCELADA
}

enum ResolucaoDivergencia {
  AJUSTE_APROVADO // diferença aceita formalmente: falta sai do grupo; sobra é creditada no destino
  RETORNO_ORIGEM // falta volta ao saldo da origem (material não chegou a sair)
}

enum StatusFechamento {
  ABERTO
  EM_CONFERENCIA
  FECHADO
}

// ───────────────────────── Usuários e acesso ─────────────────────────

model Usuario {
  id          String    @id @default(cuid())
  nome        String
  email       String    @unique
  senhaHash   String
  perfil      Perfil    @default(CONSULTA)
  situacao    Situacao  @default(ATIVO)
  criadoEm    DateTime  @default(now())
  ultimoLogin DateTime?

  sessoes         Sessao[]
  acessos         AcessoUnidade[]
  auditoria       Auditoria[]
  unidadesResp    Unidade[]           @relation("ResponsavelUnidade")
  produtosCriados Produto[]           @relation("ProdutoCriadoPor")
  vinculosCriados ProdutoUnidade[]    @relation("VinculoCriadoPor")
  movCriados      Movimento[]         @relation("MovCriadoPor")
  movValidados    Movimento[]         @relation("MovValidadoPor")
  trfEnviadas     Transferencia[]     @relation("TrfEnviadoPor")
  trfRecebidas    Transferencia[]     @relation("TrfRecebidoPor")
  trfCriadas      Transferencia[]     @relation("TrfCriadoPor")
  divAprovadas    TransferenciaItem[] @relation("DivAprovadoPor")
  saldosSicoex    SaldoSicoex[]
}

/// Sessão no servidor: o cookie leva um token aleatório; aqui guardamos só o hash SHA-256.
model Sessao {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadaEm  DateTime @default(now())
  expiraEm  DateTime
  ip        String?
  userAgent String?

  @@index([usuarioId])
}

/// Quais unidades cada usuário pode operar (ADMIN acessa todas).
model AcessoUnidade {
  usuarioId String
  unidadeId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidade   Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@id([usuarioId, unidadeId])
}

// ───────────────────────── Empresas e unidades ─────────────────────────

model Empresa {
  id           String    @id @default(cuid())
  razaoSocial  String
  nomeFantasia String
  cnpj         String    @unique // somente dígitos (14)
  situacao     Situacao  @default(ATIVO)
  criadoEm     DateTime  @default(now())
  demonstracao Boolean   @default(false)
  unidades     Unidade[]
}

model Unidade {
  id              String   @id @default(cuid())
  nome            String   @unique
  sigla           String   @unique // ex.: PEN, PIC — usada em códigos de documentos
  descricao       String?
  situacao        Situacao @default(ATIVO)
  realizaProducao Boolean  @default(false)
  empresaId       String
  empresa         Empresa  @relation(fields: [empresaId], references: [id])
  responsavelId   String?
  responsavel     Usuario? @relation("ResponsavelUnidade", fields: [responsavelId], references: [id])
  criadoEm        DateTime @default(now())
  demonstracao    Boolean  @default(false)

  acessos      AcessoUnidade[]
  produtos     ProdutoUnidade[]
  trfOrigem    Transferencia[]     @relation("TrfOrigem")
  trfDestino   Transferencia[]     @relation("TrfDestino")
  fechamentos  FechamentoSemanal[]
  saldosSicoex SaldoSicoex[]
}

// ───────────────────────── Catálogo de produtos ─────────────────────────

model Categoria {
  id       String    @id @default(cuid())
  nome     String    @unique
  produtos Produto[]
}

model UnidadeMedida {
  id            String    @id @default(cuid())
  sigla         String    @unique // kg, un, m, cx
  descricao     String
  casasDecimais Int       @default(3)
  produtos      Produto[]
}

/// Catálogo central do grupo: identificação padronizada, sem saldo.
model Produto {
  id              String               @id @default(cuid())
  codigo          String               @unique // código principal (central)
  descricao       String
  categoriaId     String
  categoria       Categoria            @relation(fields: [categoriaId], references: [id])
  unidadeMedidaId String
  unidadeMedida   UnidadeMedida        @relation(fields: [unidadeMedidaId], references: [id])
  classificacao   ClassificacaoProduto
  controlaLote    Boolean              @default(false)
  situacao        Situacao             @default(ATIVO)
  criadoEm        DateTime             @default(now())
  criadoPorId     String
  criadoPor       Usuario              @relation("ProdutoCriadoPor", fields: [criadoPorId], references: [id])
  demonstracao    Boolean              @default(false)

  vinculos     ProdutoUnidade[]
  lotes        Lote[]
  itensTrf     TransferenciaItem[]
  saldosSicoex SaldoSicoex[]

  @@index([descricao])
}

/// Cadastro operacional do produto em uma unidade. O estoque é sempre por vínculo.
model ProdutoUnidade {
  id             String   @id @default(cuid())
  produtoId      String
  produto        Produto  @relation(fields: [produtoId], references: [id])
  unidadeId      String
  unidade        Unidade  @relation(fields: [unidadeId], references: [id])
  codigoLocal    String
  situacao       Situacao @default(ATIVO)
  associadoEm    DateTime @default(now())
  associadoPorId String
  associadoPor   Usuario  @relation("VinculoCriadoPor", fields: [associadoPorId], references: [id])

  movimentos Movimento[]

  @@unique([produtoId, unidadeId]) // impede duplicidade do produto na mesma unidade
  @@unique([unidadeId, codigoLocal]) // código local único dentro da unidade
}

model Lote {
  id         String    @id @default(cuid())
  produtoId  String
  produto    Produto   @relation(fields: [produtoId], references: [id])
  numero     String
  fabricacao DateTime?
  validade   DateTime?
  criadoEm   DateTime  @default(now())

  movimentos Movimento[]
  itensTrf   TransferenciaItem[]

  @@unique([produtoId, numero])
}

// ───────────────────────── Livro-razão de estoque ─────────────────────────

/// Toda alteração de saldo é uma linha aqui. quantidade é ASSINADA (+ entra, − sai),
/// sempre na unidade de medida do produto.
model Movimento {
  id                  String             @id @default(cuid())
  tipo                TipoMovimento
  status              StatusMovimento    @default(PENDENTE)
  produtoUnidadeId    String
  produtoUnidade      ProdutoUnidade     @relation(fields: [produtoUnidadeId], references: [id])
  loteId              String?
  lote                Lote?              @relation(fields: [loteId], references: [id])
  quantidade          Decimal            @db.Decimal(18, 3)
  dataMovimento       DateTime
  documento           String?
  fornecedor          String?
  observacoes         String?
  transferenciaItemId String?
  transferenciaItem   TransferenciaItem? @relation(fields: [transferenciaItemId], references: [id])
  /// Chave natural que impede lançar o mesmo evento duas vezes (ex.: "TRF:<item>:SAIDA").
  chaveIdempotencia   String?            @unique
  criadoEm            DateTime           @default(now())
  criadoPorId         String
  criadoPor           Usuario            @relation("MovCriadoPor", fields: [criadoPorId], references: [id])
  validadoEm          DateTime?
  validadoPorId       String?
  validadoPor         Usuario?           @relation("MovValidadoPor", fields: [validadoPorId], references: [id])
  demonstracao        Boolean            @default(false)

  @@index([produtoUnidadeId, status])
  @@index([dataMovimento])
  @@index([documento])
}

// ───────────────────────── Transferências ─────────────────────────

model Transferencia {
  id                String              @id @default(cuid())
  codigo            String              @unique // TRF-2026-000001
  status            StatusTransferencia @default(RASCUNHO)
  origemId          String
  origem            Unidade             @relation("TrfOrigem", fields: [origemId], references: [id])
  destinoId         String
  destino           Unidade             @relation("TrfDestino", fields: [destinoId], references: [id])
  /// CNPJs gravados no momento do envio (cópia documental, não muda se o cadastro mudar).
  cnpjOrigem        String
  cnpjDestino       String
  documento         String?
  observacoes       String?
  dataTransferencia DateTime
  criadoPorId       String
  criadoPor         Usuario             @relation("TrfCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm          DateTime            @default(now())
  enviadoPorId      String?
  enviadoPor        Usuario?            @relation("TrfEnviadoPor", fields: [enviadoPorId], references: [id])
  enviadoEm         DateTime?
  recebidoPorId     String?
  recebidoPor       Usuario?            @relation("TrfRecebidoPor", fields: [recebidoPorId], references: [id])
  recebidoEm        DateTime?
  canceladoEm       DateTime?
  demonstracao      Boolean             @default(false)

  itens TransferenciaItem[]

  @@index([status])
}

model TransferenciaItem {
  id                 String                @id @default(cuid())
  transferenciaId    String
  transferencia      Transferencia         @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  produtoId          String
  produto            Produto               @relation(fields: [produtoId], references: [id])
  loteId             String?
  lote               Lote?                 @relation(fields: [loteId], references: [id])
  quantidadeEnviada  Decimal               @db.Decimal(18, 3)
  quantidadeRecebida Decimal?              @db.Decimal(18, 3)
  /// Preenchido somente quando há diferença e ela foi analisada.
  resolucao          ResolucaoDivergencia?
  justificativa      String?
  aprovadoPorId      String?
  aprovadoPor        Usuario?              @relation("DivAprovadoPor", fields: [aprovadoPorId], references: [id])
  aprovadoEm         DateTime?

  movimentos Movimento[]
}

// ───────────────────────── Fechamento e auditoria ─────────────────────────

model FechamentoSemanal {
  id           String           @id @default(cuid())
  unidadeId    String
  unidade      Unidade          @relation(fields: [unidadeId], references: [id])
  semanaInicio DateTime         @db.Date
  semanaFim    DateTime         @db.Date
  status       StatusFechamento @default(ABERTO)
  fechadoEm    DateTime?
  fechadoPorId String?

  @@unique([unidadeId, semanaInicio])
}

/// Trilha de auditoria imutável: quem fez o quê, quando.
model Auditoria {
  id         String   @id @default(cuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  acao       String // ex.: TRANSFERENCIA_ENVIADA
  entidade   String
  entidadeId String
  dados      Json?
  criadoEm   DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([criadoEm])
}

// ───────────────────────── Sicoex ─────────────────────────

/// Saldo informado no Sicoex (lançado no dia do desmonte) para confronto com o controle diário.
model SaldoSicoex {
  id          String   @id @default(cuid())
  unidadeId   String
  unidade     Unidade  @relation(fields: [unidadeId], references: [id])
  produtoId   String
  produto     Produto  @relation(fields: [produtoId], references: [id])
  data        DateTime @db.Date
  saldo       Decimal  @db.Decimal(18, 3)
  observacoes String?
  criadoEm    DateTime @default(now())
  criadoPorId String
  criadoPor   Usuario  @relation(fields: [criadoPorId], references: [id])

  @@unique([unidadeId, produtoId, data])
  @@index([data])
}

# Conexão usada pela aplicação (em Supabase/Neon: a URL com pool, porta 6543, com ?pgbouncer=true)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/explo_control?schema=public"
# Conexão direta, usada pelas migrações (em servidor próprio: igual à DATABASE_URL)
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/explo_control?schema=public"
SESSION_SECRET="gere-um-valor-aleatorio-longo"
